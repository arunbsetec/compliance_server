# Variables read by fastapi/src/server/core/config.py.
# Copy this file to .env and replace the placeholder secrets.
# DATABASE_URL and JWT_SECRET are required. The API will not start without them.
# Every other variable has a default and can be left as written for local development.

# PostgreSQL connection. Used by SQLAlchemy in server/db/session.py.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/compliance

# Secret used to sign and verify login JWTs (HS256) in server/core/security.py.
# Use a long random string. Do not commit the real value.
JWT_SECRET=change-me

# How long an access token stays valid, in minutes. Default: 60.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq API key. Document upload still works without it.
# Extraction fails until this and GROQ_MODEL are both set.
# Used by server/services/groq_client.py.
GROQ_API_KEY=

# Groq model name sent with each extraction request. No default in code.
GROQ_MODEL=openai/gpt-oss-120b

# Groq OpenAI-compatible base URL. Default: https://api.groq.com/openai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Directory for uploaded PDFs. Empty means fastapi/uploads.
# A relative path is resolved from the fastapi directory.
# Used by server/services/document_service.py.
UPLOAD_DIR=

# Largest accepted upload, in bytes. Default: 10485760 (10 MB).
# Checked in server/routes/documents.py and server/services/document_service.py.
MAX_UPLOAD_BYTES=10485760


# Comma-separated browser origins allowed to call the API.
# Must include the React dev server. Used by server/main.py.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
